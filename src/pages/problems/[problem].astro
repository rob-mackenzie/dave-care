---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const problems = await getCollection('problems');
  return problems.map((problem) => ({ params: { problem: problem.id }, props: { problem } }));
}

const { problem } = Astro.props;
const { Content } = await render(problem);
---

<Base title={problem.data.title}>
  <p class="back"><a href="/problems/">← All problems</a></p>
  <h1>{problem.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</Base>
