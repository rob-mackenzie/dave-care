---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);

const sections = (await getCollection('pages', (page) => page.id !== 'home'))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={home.data.title} description={home.data.description}>
  <h1>{home.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
  <ul class="cards">
    {sections.map((page) => (
      <li>
        <a href={`/${page.id}/`}>
          <strong>{page.data.title}</strong>
          {page.data.description && <span>{page.data.description}</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
