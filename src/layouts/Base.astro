---
import { getCollection, getEntry } from 'astro:content';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const home = await getEntry('pages', 'home');
const siteName = home?.data.title ?? 'Care notes';
const menu = (await getCollection('pages', (page) => page.data.menu))
  .sort((a, b) => a.data.order - b.data.order);
const here = Astro.url.pathname.replace(/\/?$/, '/');
const isHome = here === '/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2f6f5e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{isHome ? siteName : `${title} · ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href="/">{siteName}</a>
        <nav aria-label="Main">
          {menu.map((page) => {
            const href = page.id === 'home' ? '/' : `/${page.id}/`;
            const current = page.id === 'home' ? isHome : here.startsWith(href);
            return (
              <a href={href} aria-current={current ? 'page' : undefined}>
                {page.data.menu}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    {here !== '/contacts/' && (
      <footer class="site-footer">
        <div class="wrap">
          Not sure what to do? <a href="/contacts/">See who to call</a>.
        </div>
      </footer>
    )}

    <script>
      // Make Markdown task lists ("- [ ] ...") tickable. Ticks are kept on
      // this device for today only, so each visit starts with a clean list.
      const boxes = [...document.querySelectorAll<HTMLInputElement>('.prose li input[type="checkbox"]')];

      if (boxes.length) {
        const today = new Date().toDateString();
        const key = `ticks:${location.pathname}`;
        const load = (): number[] => {
          try {
            const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
            return saved?.date === today ? saved.ticked : [];
          } catch {
            return [];
          }
        };
        const save = () => {
          const ticked = boxes.flatMap((box, i) => (box.checked ? [i] : []));
          try {
            localStorage.setItem(key, JSON.stringify({ date: today, ticked }));
          } catch {
            // Private browsing: ticks just won't survive a reload.
          }
        };
        const show = (box: HTMLInputElement) =>
          box.closest('li')?.classList.toggle('done', box.checked);

        const ticked = load();
        boxes.forEach((box, i) => {
          const item = box.closest('li')!;
          box.disabled = false;
          box.checked = ticked.includes(i);
          box.setAttribute('aria-label', item.textContent?.trim() ?? 'Done');
          item.classList.add('tickable');
          show(box);
          box.addEventListener('change', () => {
            show(box);
            save();
          });
          // Let the whole row be tapped, not just the little box.
          item.addEventListener('click', (event) => {
            const target = event.target as HTMLElement;
            if (target === box || target.closest('a, button, input, iframe')) return;
            if (target.closest('li') !== item) return;
            box.checked = !box.checked;
            box.dispatchEvent(new Event('change'));
          });
        });

        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'reset-ticks';
        reset.textContent = 'Clear all ticks';
        reset.addEventListener('click', () => {
          boxes.forEach((box) => {
            box.checked = false;
            show(box);
          });
          save();
        });
        document.querySelector('.prose')?.append(reset);
      }
    </script>
  </body>
</html>
